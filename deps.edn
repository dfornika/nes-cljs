{:paths ["src/main" "resources"]
 :deps {;; 1.12 or later: nes.cpu.core's type hints use its array class
        ;; syntax (^int/1 for int[])
        org.clojure/clojure {:mvn/version "1.12.0"}
        org.clojure/clojurescript {:mvn/version "1.12.145"}
        org.clojure/core.async {:mvn/version "1.9.865"}
        ;; the 6502's opcode table and disassembler (zeropage.opcodes,
        ;; zeropage.disasm), and the CPU interface nes.cpu.zeropage
        ;; implements: libs/zeropage in the toolkit repo
        io.github.dfornika/zeropage {:git/url "https://github.com/dfornika/nes-gamedev-toolkit-clj"
                                     :git/sha "3c05b709de5bd1b1cb8d5af82012abf3557a6a07"
                                     :deps/root "libs/zeropage"}
        cljs-http/cljs-http {:mvn/version "0.1.48"}
        reagent/reagent {:mvn/version "2.0.1"
                         :exclusions [cljsjs/react cljsjs/react-dom]}
        ;; For the in-browser editor (the :web build): SCI interprets
        ;; ClojureScript typed into the page; sci.configs exposes Reagent to it.
        org.babashka/sci {:mvn/version "0.15.59"}
        io.github.babashka/sci.configs {:git/sha "f3ca6e2ddf59f4e79e2f07d977cae416949135c2"}}
 :aliases {:dev {:extra-paths ["src/dev"]
                 :extra-deps {thheller/shadow-cljs {:mvn/version "3.5.4"}
                              binaryage/devtools {:mvn/version "1.0.7"}
                              ;; data browser for tap> (dev builds only)
                              djblue/portal {:mvn/version "0.65.0"}}}
           :test {:extra-deps {org.clojure/test.check {:mvn/version "1.1.1"}}
                  :extra-paths ["src/test"]}
           ;; The .cljc tests again, on the JVM (npm run test:jvm): the code
           ;; that isn't tied to the browser has to work in both places.
           :test-jvm {:extra-deps {io.github.cognitect-labs/test-runner
                                   {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
                      :main-opts ["-m" "cognitect.test-runner" "-d" "src/test"]}}}
