{:deps true
 :dev-http {9500 "resources/public"}
 :builds {:app {:target :browser
                :output-dir "resources/public/js"
                :asset-path "/js"
                ;; the REPL starts in nes.repl, with its tools at hand
                :devtools {:repl-init-ns nes.repl
                           ;; dev-only code, left out of release builds
                           :preloads [nes.dev.portal]}
                :modules {:main
                          {:init-fn nes.main/init}}
                :build-hooks [(shadow.cljs.build-report/hook {:output-to "build-reports/report.html"})]
                :release {:compiler-options {:optimizations :simple}}}
          :test {:target :node-test
                 :output-to "target/test/test.js"
                 :ns-regexp "-test$"
                 ;; bundle npm packages, as the browser build does: Node loads
                 ;; jsnes's bundle as an ES module (its package says "type":
                 ;; "module") and gets nothing from it
                 :js-options {:js-provider :shadow}
                 :autorun true}}}
